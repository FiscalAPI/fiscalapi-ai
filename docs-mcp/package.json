{
  "name": "@fiscalapi/docs-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP de solo lectura con la documentación y la referencia de la API de FiscalAPI (CFDI 4.0) para agentes de código.",
  "type": "module",
  "bin": {
    "fiscalapi-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "README.md"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.ts",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build && npm run build:data"
  },
  "keywords": [
    "fiscalapi",
    "mcp",
    "documentacion",
    "openapi",
    "cfdi",
    "cfdi-4.0",
    "factura",
    "sat",
    "mexico"
  ],
  "author": "FiscalAPI",
  "license": "MPL-2.0",
  "homepage": "https://docs.fiscalapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiscalAPI/fiscalapi-ai.git",
    "directory": "docs-mcp"
  },
  "bugs": {
    "url": "https://github.com/FiscalAPI/fiscalapi-ai/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@orama/stemmers": "3.1.18",
    "@orama/stopwords": "3.1.18",
    "minisearch": "7.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
